# VeriDraw JSON-file version: no database engine, SQL Server, or Docker needed.
# Relative DATA_FILE paths resolve inside the backend directory.
DATA_FILE=./data/veridraw.json
VRF_PRIVATE_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS_FROM_KEYS_GENERATE
ADMIN_EMAIL=organizer@example.test
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_14_CHARACTERS
FRONTEND_ORIGIN=http://127.0.0.1:5173
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
ENABLE_DEMO=true
